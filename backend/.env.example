# Copier ce fichier en .env (jamais commité) et remplir avec le compte « backend » du broker.
# Adresse du déploiement : console EMQX Cloud > Overview > Connection Information.
MQTT_URL=mqtts://xxxxxxxx.ala.eu-central-1.emqxsl.com:8883
MQTT_USERNAME=backend
MQTT_PASSWORD=
# Facultatif : chemin vers emqxsl-ca.crt, seulement si la connexion échoue sur une erreur de certificat.
MQTT_CA_FILE=
DB_FILE=historique.db
RETENTION_JOURS=30
PORT=3000
